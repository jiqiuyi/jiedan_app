<?xml version="1.0" encoding="utf-8"?>
<!-- 接单管家·记账 桌面小组件布局（华为兼容极简版 v1.46.7）
     仅 LinearLayout + TextView，全部字面值颜色，无主题属性 / 自定义字体 /
     shape drawable / 复杂控件，从根源消除 HarmonyOS/EMUI 对 RemoteViews
     inflate 失败导致「加载窗口小工具时出现问题」的可能。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F3F5"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="接单管家·记账"
        android:textColor="#4A5AF0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="点击记一笔开始记账"
        android:textColor="#1B2233"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_quick_ledger"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:background="#4A5AF0"
        android:gravity="center"
        android:text="记一笔"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
